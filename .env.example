# Copy to .env and fill in these two values. Never commit .env.
#
# Everything else is hardcoded in config.py — owner id, admins, workers,
# rate limit, log format, temp dir. There is nothing else to set here.

BOT_TOKEN=your_bot_token_here

# A database in the path is used as-is; without one the bot falls back to
# config.MONGO_DB_DEFAULT.
MONGO_URI=mongodb://127.0.0.1:27017/sakura_validator_x
